# ─── Required ─────────────────────────────────────────────────────────────────
# Copy this to .env and fill in real values. Never commit .env to git.

# PostgreSQL
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=projectx

# JWT — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_a_very_long_random_secret_at_least_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_to_another_very_long_random_secret_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional ─────────────────────────────────────────────────────────────────
NODE_ENV=production
API_PORT=3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=warn

# pgAdmin (dev profile only) — use a real email format
PGADMIN_EMAIL=admin@gmail.com
PGADMIN_PASSWORD=admin

# ─── Roles (reference) ────────────────────────────────────────────────────────
# Available roles: SUPER_ADMIN | ADMIN | USER
# Default role for new users: USER
